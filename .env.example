# APK Site environment defaults
# Copy this file to .env and adjust per deployment.

# Core service
APP_ENV=development
APK_DIR=./data/apk
APK_PORT=5003
APK_HOST=0.0.0.0
APK_LOG_DIR=./logs
APP_PORTAL_MODE=all
ADMIN_PORT=5003
PLAYER_PORT=5004
FORUM_PORT=5005
APK_DEBUG=false
# Required when APP_ENV=production (see docs/runbooks/production_secrets.md)
APK_SECRET=

# Webhook secrets (required in production)
JENKINS_BUILD_WEBHOOK_SECRET=
APPROVAL_WEBHOOK_SECRET=
BUILD_NODE_WEBHOOK_SECRET=
INTERNAL_WEBHOOK_IPS=127.0.0.1,::1

# External/public URLs
PUBLIC_URL=
EXTERNAL_DOMAIN=
PLAYER_PUBLIC_URL=
FORUM_PUBLIC_URL=
ADMIN_PUBLIC_URL=
OSS_CUSTOM_DOMAIN=
PLAYER_DOMAIN=
FORUM_DOMAIN=
ADMIN_DOMAIN=

# Jenkins
JENKINS_URL=http://localhost:8080
JENKINS_USER=
JENKINS_TOKEN=
JENKINS_JOB_NAME=Android
JENKINS_BUILDS_DIR=./data/jenkins_instances/default/jobs/Android/builds
JENKINS_INSTANCES_DIR=./data/jenkins_instances
JENKINS_WAR_PATH=
JENKINS_DOCKER_IMAGE=jenkins/jenkins:lts-jdk17
JENKINS_CONTAINER_NAME=apk-site-jenkins
JENKINS_DEFAULT_USER=admin
# Dev only: set a local Jenkins admin password. Production must use secrets manager / env injection.
JENKINS_DEFAULT_PASSWORD=

# Game server cluster relay (dev stack sets this in Start-DevStack.ps1)
CLUSTER_RELAY_TOKEN=

# Security
FORCE_LOGIN=true
INNER_NET=192.168.,10.,127.,26.26.
IP_WHITELIST=
LOGIN_ATTEMPTS_LIMIT=5
LOGIN_LOCKOUT_MINUTES=15

# Storage mode
USE_SQLITE=true
SQLITE_MIRROR_JSON=false
SQLITE_IMPORT_JSON_ON_MISS=false

# Optional email report
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
REPORT_EMAIL_TO=
REPORT_HOUR=8

# Optional alerting
ALERT_FEISHU_WEBHOOK=
DISK_ALERT_GB=5

# Optional backup schedule
BACKUP_SCHEDULED=true
BACKUP_HOUR=2
BACKUP_RETENTION_COUNT=7
