{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "business_test_plan.schema.json",
  "title": "BusinessTestPlan",
  "type": "object",
  "required": ["plan_id", "name", "category", "version", "transport", "steps"],
  "properties": {
    "plan_id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "category": { "type": "string", "minLength": 1 },
    "source": { "type": "string", "enum": ["builtin", "custom"] },
    "version": { "type": "integer", "minimum": 1 },
    "transport": { "type": "string", "enum": ["websocket", "tcp", "kcp", "http"] },
    "endpoint": {
      "type": "object",
      "properties": {
        "ws": { "type": "string" },
        "tcp": { "type": "string" },
        "kcp": { "type": "string" },
        "http": { "type": "string" }
      }
    },
    "context": {
      "type": "object",
      "properties": {
        "server_id": { "type": "string" },
        "user_prefix": { "type": "string" },
        "password": { "type": "string" }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "protocol"],
        "properties": {
          "id": { "type": "string" },
          "protocol": { "type": "string", "pattern": "_c2s$" },
          "expect_response": { "type": "string" },
          "on_blocked": { "type": "string", "enum": ["skip", "fail"] },
          "extract": { "type": "object", "additionalProperties": { "type": "string" } },
          "assertions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["field", "op", "value"],
              "properties": {
                "field": { "type": "string" },
                "op": { "type": "string", "enum": ["eq", "neq", "exists"] },
                "value": {}
              }
            }
          }
        }
      }
    },
    "tags": { "type": "array", "items": { "type": "string" } }
  }
}
