# Staging notify / incident loop (P2-03)
# Copy to staging host .env — never commit secrets.

APP_ENV=staging

# Universal signed webhook (preferred)
NOTIFY_WEBHOOK_URL=https://your-staging-webhook.example/hook
NOTIFY_SIGNING_SECRET=change-me-staging

# Optional channel-specific fallbacks
WEBHOOK_FEISHU_URL=
WEBHOOK_DINGTALK_URL=

# Internal metrics scrape (Prometheus)
INTERNAL_WEBHOOK_IPS=127.0.0.1,10.0.0.0/8

# Staging auto-rollback policy default ON
# release_policy.auto_rollback_on_verify_fail=true for env_key=staging
