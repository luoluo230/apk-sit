<?xml version='1.1' encoding='UTF-8'?>
<project>
  <actions/>
  <description>P5-01 GAP-P2-01-OUT-02: GameServer build job scaffold for Portal server-release plane.</description>
  <keepDependencies>false</keepDependencies>
  <properties>
    <hudson.model.ParametersDefinitionProperty>
      <parameterDefinitions>
        <hudson.model.StringParameterDefinition>
          <name>PROJECT_ID</name>
          <description>Portal project_id</description>
          <defaultValue></defaultValue>
          <trim>true</trim>
        </hudson.model.StringParameterDefinition>
        <hudson.model.StringParameterDefinition>
          <name>SERVER_RELEASE_ID</name>
          <description>Portal server release order id</description>
          <defaultValue></defaultValue>
          <trim>true</trim>
        </hudson.model.StringParameterDefinition>
        <hudson.model.StringParameterDefinition>
          <name>GIT_BRANCH</name>
          <description>Game server branch</description>
          <defaultValue>main</defaultValue>
          <trim>true</trim>
        </hudson.model.StringParameterDefinition>
        <hudson.model.StringParameterDefinition>
          <name>PORTAL_BASE_URL</name>
          <description>Portal callback base URL</description>
          <defaultValue>http://127.0.0.1:5003</defaultValue>
          <trim>true</trim>
        </hudson.model.StringParameterDefinition>
      </parameterDefinitions>
    </hudson.model.ParametersDefinitionProperty>
  </properties>
  <scm class="hudson.scm.NullSCM"/>
  <canRoam>true</canRoam>
  <disabled>false</disabled>
  <blockBuildWhenDownstreamBuilding>false</blockBuildWhenDownstreamBuilding>
  <blockBuildWhenUpstreamBuilding>false</blockBuildWhenUpstreamBuilding>
  <triggers/>
  <concurrentBuild>false</concurrentBuild>
  <builders>
    <hudson.tasks.BatchFile>
      <command>@echo off
echo GameServer-Build PROJECT_ID=%PROJECT_ID% SERVER_RELEASE_ID=%SERVER_RELEASE_ID% GIT_BRANCH=%GIT_BRANCH%
echo Portal=%PORTAL_BASE_URL%
echo Scaffold job for P5-01; replace with real GameServer pipeline when agent ready.
exit /b 0
</command>
    </hudson.tasks.BatchFile>
  </builders>
  <publishers/>
  <buildWrappers/>
</project>
