reports/
*.db-wal
*.db-shm
*.rdb
dump.rdb

# Build artifacts (regenerated by scripts/build_split_deploy_bundles.py)
portals/common/artifacts/
portals/common/core/release_bundles/

# Common local output folders
portals/common/core/runtime/
portals/common/core/tmp/
portals/common/tmp/

# Codex auto-backups (not for commit)
.codex-backups/

