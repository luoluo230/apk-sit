# Local secrets and environment files
.env
.env.*
!.env.example
!.env.devstack.example
.env.devstack
jenkins_credentials.json
config/settings.json
data/secret.key
data/secret.key.not-so-secret

# Python cache and virtual env
__pycache__/
*.py[cod]
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/

# Node dependencies and build cache
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Project runtime logs and backups
logs/
backups/
*.log
*.out
*.err

# Runtime pid/lock/temp artifacts
*.pid
*.pid.lock
*.tmp
*.temp

# Database local runtime artifacts
data/apk_site.db
data/apk_site.db-shm
data/apk_site.db-wal
